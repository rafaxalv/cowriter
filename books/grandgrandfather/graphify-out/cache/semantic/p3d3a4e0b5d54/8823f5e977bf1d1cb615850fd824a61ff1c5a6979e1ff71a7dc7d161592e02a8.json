an_from_spain", "label": "Part IV \u2014 The Woman from Spain (c. 1858\u20131877)", "file_type": "concept", "source_file": "outline/chapters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "part5_fortune", "label": "Part V \u2014 Fortune (c. 1877\u20131888)", "file_type": "concept", "source_file": "outline/chapters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "angelique_warning", "label": "Madame Ang\u00e9lique's warning about Black men", "file_type": "concept", "source_file": "outline/chapters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fear she carries to Corumb\u00e1; she admits it to him as a sign of trust."}, {"id": "loteria_da_corte", "label": "Loteria da Corte (Court lottery)", "file_type": "concept", "source_file": "outline/chapters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1867\u20131880: one draw of 6,000 tickets, top prize 20 contos (Loner 2014)."}, {"id": "o_iniciador", "label": "O Iniciador (Corumb\u00e1 newspaper, 1877)", "file_type": "concept", "source_file": "outline/chapters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "loner_2014", "label": "Loner 2014, 'A Loteria do Ipiranga'", "file_type": "paper", "source_file": "outline/chapters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "urine_letter", "label": "The dismissal letter that smells of urine", "file_type": "concept", "source_file": "outline/chapters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tonico fires Ezequiel; catharsis point; the joke outlives his title."}, {"id": "hideout_burnin